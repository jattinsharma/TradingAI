# ====================================
# Universal AI Trading Copilot — Backend
# Environment Variables
# ====================================

# ---- Server Configuration ----
PORT=3000
NODE_ENV=development

# ---- MongoDB (replaces PostgreSQL) ----
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/trading_copilot?retryWrites=true&w=majority
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trading_copilot?retryWrites=true&w=majority

# ---- JWT Authentication ----
JWT_SECRET=generate-a-random-64-char-secret-here-in-production
JWT_REFRESH_SECRET=generate-a-separate-random-64-char-refresh-secret
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000,chrome-extension://*

# ---- Redis (Upstash compatible) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# For Upstash Redis:
# REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379

# ---- External API Keys ----
OPENAI_API_KEY=
NEWS_API_KEY=
TWELVE_DATA_KEY=
ALPHA_VANTAGE_KEY=
FINNHUB_KEY=
POLYGON_KEY=

# ---- Rate Limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ---- Logging ----
LOG_LEVEL=debug
