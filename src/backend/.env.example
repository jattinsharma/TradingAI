# ====================================
# Universal AI Trading Copilot — Backend
# Environment Variables
# ====================================

# ---- Server Configuration ----
PORT=3000
NODE_ENV=development

# ---- MongoDB (replaces PostgreSQL) ----
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/trading_copilot?retryWrites=true&w=majority
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trading_copilot?retryWrites=true&w=majority

# ---- JWT Authentication ----
JWT_SECRET=generate-a-random-64-char-secret-here-in-production
JWT_REFRESH_SECRET=generate-a-separate-random-64-char-refresh-secret
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated list of allowed origins for browser/extension requests.
# Chrome extension origins are chrome-extension://<extension-id>.
# In production, include your deployed frontend URL and chrome-extension://*.
# For development, use http://localhost:3000 and the extension's origin.
# Set to * to allow all origins (only for local development).
CORS_ORIGIN=https://tradingai-4dq2.onrender.com,chrome-extension://*

# ---- Redis (OPTIONAL — in-memory fallback is used if REDIS_URL is empty/unset) ----
# Leave REDIS_URL empty to use the built-in in-memory cache (no Redis required).
# Set REDIS_URL to a connection string for Redis or Upstash Redis:
#   rediss://default:<password>@<region>.upstash.io:6379
#   redis://localhost:6379
REDIS_URL=

# ---- External API Keys ----
OPENAI_API_KEY=
NEWS_API_KEY=
TWELVE_DATA_KEY=
ALPHA_VANTAGE_KEY=
FINNHUB_KEY=
POLYGON_KEY=

# ---- Rate Limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ---- Logging ----
LOG_LEVEL=debug
