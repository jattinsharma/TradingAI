{
  "manifest_version": 3,
  "name": "Universal AI Trading Copilot",
  "description": "AI-powered trading assistant that works across multiple trading platforms",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/*",
        "https://*.binance.com/*",
        "https://*.bybit.com/*",
        "https://*.coinbase.com/*",
        "https://*.zerodha.com/*",
        "https://*.upstox.com/*",
        "https://*.angelone.in/*",
        "https://*.groww.in/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "notifications",
    "alarms",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.tradingview.com/*",
    "https://*.binance.com/*",
    "https://*.bybit.com/*",
    "https://*.coinbase.com/*",
    "https://*.zerodha.com/*",
    "https://*.upstox.com/*",
    "https://*.angelone.in/*",
    "https://*.groww.in/*",
    "https://tradingai-4dq2.onrender.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["overlay.html", "assets/*"],
      "matches": [
        "https://*.tradingview.com/*",
        "https://*.binance.com/*",
        "https://*.bybit.com/*",
        "https://*.coinbase.com/*",
        "https://*.zerodha.com/*",
        "https://*.upstox.com/*",
        "https://*.angelone.in/*",
        "https://*.groww.in/*"
      ]
    }
  ]
}
